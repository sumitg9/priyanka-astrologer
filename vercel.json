{
  "version": 2,
  "functions": {
    "api/index.php": {
      "runtime": "vercel-php@0.9.0"
    }
  },
  "routes": [
    {
      "src": "/assets/(.*)",
      "dest": "/assets/$1"
    },
    {
      "src": "/styles\\.css",
      "dest": "/assets/css/styles.css"
    },
    {
      "src": "/script\\.js",
      "dest": "/assets/js/script.js"
    },
    {
      "src": "/favicon\\.ico",
      "dest": "/assets/images/lotus-logo.png"
    },
    {
      "src": "/(.*)",
      "dest": "/api/index.php"
    }
  ]
}